# ==============================================================================
# MEZDOHUB — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Security Standard: Client-Safe Public Key Injection (Vite SPA)
# ==============================================================================
# Instructions:
# 1. Copy this file or set these variables in your deployment hosting dashboard.
# 2. Replace with your genuine credentials obtained from Supabase Project Settings -> API.
# 3. DO NOT paste SUPABASE_SERVICE_ROLE_KEY into this client bundle.
# ==============================================================================

# 1. Supabase Cloud Production Database Endpoint
# Format: https://[your-project-ref].supabase.co
VITE_SUPABASE_URL=https://[YOUR_PROJECT_REFERENCE].supabase.co

# 2. Supabase Anonymous Client Public Key (Safe for Browser)
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Google Analytics 4 Telemetry ID (Optional for Conversion Tracking)
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 4. MezdoHub Production Deployment Environment
VITE_APP_ENV=production
